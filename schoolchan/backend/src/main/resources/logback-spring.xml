<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured logging.

  The default profile writes plain text. Start the app with the "json" profile
  (or -Dspring.profiles.active=local,json) to get one JSON object per line,
  which is what a log collector wants.

  Post bodies and IP addresses are never logged.
-->
<configuration>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [schoolchan] %-40.40logger{39} : %m%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [schoolchan] %-40.40logger{39} : %m%n%ex</pattern>
        </encoder>
    </appender>

    <springProfile name="json">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!json">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
