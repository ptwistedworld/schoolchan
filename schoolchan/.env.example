# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/schoolchan
SPRING_DATASOURCE_USERNAME=schoolchan
SPRING_DATASOURCE_PASSWORD=schoolchan

# Staff seed
SCHOOLCHAN_ADMIN_USERNAME=admin
SCHOOLCHAN_ADMIN_PASSWORD=change-me-now

# AES-256 key for poster metadata (32 bytes base64)
SCHOOLCHAN_METADATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ML sidecar
SCHOOLCHAN_ML_BASE_URL=http://localhost:8090
SCHOOLCHAN_ML_ENABLED=true
MOCK_MODE=true

# Retention
SCHOOLCHAN_METADATA_RETENTION_DAYS=90

# Access
SCHOOLCHAN_TIMEZONE=Asia/Manila
SCHOOLCHAN_CLOSED_MODE=READ_ONLY
